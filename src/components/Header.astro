---
import { Image } from 'astro:assets';
import { contacts } from '../data/contact';
import { getImageAsset } from '../utils/images';

interface Props {
  name: string;
  title: string;
  photo: string;
}

const { name, title, photo } = Astro.props;
const portrait = getImageAsset(photo);
---

<header class="bg-header-bg text-header-text p-6">
  <div class="flex items-center border-b-2 border-primary-on-dark pb-4 mb-4">
    <Image
      src={portrait}
      alt={name}
      width={96}
      height={96}
      loading="eager"
      class="w-24 h-24 rounded-full border-2 border-primary-on-dark mr-6 object-cover"
    />
    <div>
      <h1 class="text-4xl font-bold mb-2">{name}</h1>
      <h2 class="text-xl">{title}</h2>
    </div>
  </div>

  <address class="not-italic grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {
      contacts.map(({ icon: Icon, text, href }) => (
        <div class="flex items-center mb-2">
          <Icon class="w-5 h-5 mr-2 text-primary-on-dark shrink-0" aria-hidden="true" />
          {href ? (
            <a
              href={href}
              class="text-header-text hover:text-primary-on-dark transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >
              {text}
            </a>
          ) : (
            <span class="text-header-text">{text}</span>
          )}
        </div>
      ))
    }
  </address>
</header>
