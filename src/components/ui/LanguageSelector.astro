---
import type { Locale } from '../../i18n/utils';
import { getAlternateUrl } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const alternateLocale: Locale = locale === 'es' ? 'en' : 'es';
const alternateUrl = getAlternateUrl(Astro.url, alternateLocale);
---

{/* Enlace real, no un botón con estado: cada idioma tiene su URL indexable. */}
<a
  href={alternateUrl}
  data-language-toggle
  hreflang={alternateLocale}
  lang={alternateLocale}
  aria-label={locale === 'es' ? 'Switch to English' : 'Cambiar a español'}
  class="bg-primary text-primary-contrast px-4 py-2 rounded-md hover:bg-primary-hover transition-colors"
>
  {alternateLocale.toUpperCase()}
</a>

<script>
  /* Recuerda el idioma elegido y redirige en la siguiente visita a la raíz.
     Se ejecuta sólo si el usuario ha elegido explícitamente, para no secuestrar
     enlaces compartidos a una URL concreta. */
  const STORAGE_KEY = 'cv-preferred-locale';

  document.querySelector('[data-language-toggle]')?.addEventListener('click', (event) => {
    const target = event.currentTarget as HTMLAnchorElement;
    localStorage.setItem(STORAGE_KEY, target.getAttribute('hreflang') ?? 'es');
  });

  const preferred = localStorage.getItem(STORAGE_KEY);
  const currentIsEnglish = location.pathname.startsWith('/en');

  if (preferred === 'en' && !currentIsEnglish) {
    location.replace('/en/');
  } else if (preferred === 'es' && currentIsEnglish) {
    location.replace('/');
  }
</script>
