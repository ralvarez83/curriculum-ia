---
import type { AstroComponent } from '@lucide/astro';

interface Props {
  title: string;
  icon: AstroComponent;
}

const { title, icon: Icon } = Astro.props;
---

<section class="cv-section mb-8">
  <h3
    class="cv-section-title text-2xl font-semibold mb-4 text-text flex items-center"
  >
    <Icon class="mr-2 text-primary" />
    {title}
  </h3>
  <slot />
</section>
