---
import { getImage } from 'astro:assets';
import '../styles/globals.css';
import type { Locale } from '../i18n/utils';
import { getAlternateUrl, getTranslations } from '../i18n/utils';
import { getImageAsset } from '../utils/images';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const alternateLocale: Locale = locale === 'es' ? 'en' : 'es';

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const alternateUrl = new URL(getAlternateUrl(Astro.url, alternateLocale), Astro.site);

// Para las tarjetas de redes sociales se genera un JPEG aparte: no todos los
// rastreadores entienden el WebP que se sirve en la página.
const ogImage = await getImage({ src: getImageAsset(t.photo), format: 'jpeg' });

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: t.name,
  jobTitle: t.title,
  email: 'rubenag83@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  url: canonicalUrl.href,
  sameAs: ['https://github.com/ralvarez83', 'https://linkedin.com/in/rubenalvarezgonzalez'],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    {/* Antes que nada: fija el tema para que la página no parpadee del claro
        al oscuro. Respeta lo que el usuario eligió y, si no ha elegido, la
        preferencia del navegador. Sin JavaScript no se ejecuta, pero la hoja
        de estilos cubre ese caso con una media query. */}
    <script is:inline>
      (() => {
        const guardado = localStorage.getItem('cv-theme');
        const oscuro = guardado
          ? guardado === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = oscuro ? 'dark' : 'light';
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl.href} />
    <link rel="alternate" hreflang={alternateLocale} href={alternateUrl.href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site).href} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_ES'} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
